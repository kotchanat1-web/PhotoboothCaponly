{
  "mode": "kiosk",
  "boothName": "Photobooth",
  "window": { "fullscreen": false, "kiosk": false, "width": 1280, "height": 720 },
  "prices": { "1": 130, "2": 250, "3": 375, "4": 500 },
  "currency": "THB",
  "timeoutsSec": {
    "selectPayment": 30,
    "selectQty": 30,
    "creatingCharge": 20,
    "confirmCancel": 15,
    "selectTemplate": 60,
    "instruction": 10,
    "shooting": 20,
    "review": 2,
    "compose": 30,
    "print": 60,
    "showQr": 120,
    "error": 30,
    "deviceError": 30
  },
  "capture": { "countdownSec": 5, "retries": 1, "mirrorLiveView": true },
  "camera": {
    "driver": "mock",
    "powerCycle": { "enabled": true, "maxAttempts": 2, "offMs": 3000, "bootMs": 8000 }
  },
  "printer": { "driver": "mock" },
  "payment": { "provider": "mock", "qrExpirySec": 120, "mock": { "autoPaySec": 0 } },
  "relay": {
    "driver": "mock",
    "channels": { "cabinetLight": 1, "sessionActive": 2, "paid": 3, "cameraPower": 4 }
  },
  "event": { "printCopies": 1 },
  "paths": { "sessionsDir": "", "logsDir": "", "templatesDir": "" },
  "logRetentionDays": 30
}
