{
  "name": "photobooth",
  "version": "0.1.0",
  "private": true,
  "description": "Photobooth kiosk/event app (PRD v1.2)",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "dist:win": "electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "build": {
    "appId": "local.photobooth.app",
    "productName": "Photobooth",
    "files": [
      "out/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "config/default.json",
        "to": "config/default.json"
      }
    ],
    "win": {
      "target": "nsis"
    }
  }
}
