{
  "name": "photobooth-payments",
  "version": "0.1.0",
  "private": true,
  "description": "Payment verification server for the photobooth (Cloudflare Worker + D1 + Durable Objects) — DEC-018",
  "scripts": {
    "dev": "wrangler dev --local",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply photobooth --local",
    "db:migrate:remote": "wrangler d1 migrations apply photobooth --remote",
    "add-booth": "node scripts/add-booth.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.9.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1",
    "wrangler": "^4.166.0"
  }
}
